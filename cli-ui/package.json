{
  "name": "@aetherdeploy/cli-ui",
  "version": "1.0.0",
  "description": "AetherDeploy — Copilot-style terminal UI",
  "type": "module",
  "bin": {
    "aetherdeploy": "./bin/aetherdeploy.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node bin/aetherdeploy.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
