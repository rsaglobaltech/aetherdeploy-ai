# LLM Backend (ollama | anthropic | openai)
AETHER_LLM_BACKEND=ollama
AETHER_LLM_MODEL=gemma3:1b
AETHER_LLM_BASE_URL=http://localhost:11434
AETHER_LLM_WAIT_FOREVER=false
AETHER_LLM_RETRY_INTERVAL=3
# AETHER_LLM_API_KEY=sk-...   # solo si usas Anthropic/OpenAI

# Cloud provider por defecto
AETHER_DEFAULT_PROVIDER=aws
AETHER_DEFAULT_REGION=us-east-1

# Terraform
AETHER_TERRAFORM_BINARY=terraform

# Observabilidad (opcional)
AETHER_OTEL_ENABLED=false
AETHER_OTEL_ENDPOINT=http://localhost:4317
